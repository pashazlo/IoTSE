CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="16MB"

# PSRAM Configuration
CONFIG_SPIRAM=y
CONFIG_SPIRAM_TYPE_OCT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_PSRAM_FIRST=y

# ИСПРАВЛЕНИЕ: Подними лимит для Internal Allocations (по умолчанию 4096)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ИСПРАВЛЕНИЕ: Увеличь резерв внутренней памяти (32КБ очень мало для Wi-Fi/FATFS/DMA)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Heap Configuration
CONFIG_HEAP_MEMORY_PROTECTION=y

# FreeRTOS
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTER_IN_TCB=y

# Protect FatFs file objects when background capture/export and File Manager
# access the same mounted volume.
CONFIG_FATFS_FS_LOCK=8

# Logging
CONFIG_LOG_DEFAULT_LEVEL=2

# Performance
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10

# The internal ESP32-S3 radio is reserved for Wi-Fi in this firmware.
# CONFIG_BT_ENABLED is not set

# Wi-Fi RX buffers — «кристальный» приём для promiscuous-сниффера.
# Драйвер может ронять кадры ДО нашего callback, и такие потери не видны
# счётчикам DROP/OVER в WIFI_PIPE. Больше драйверных RX-буферов и шире окно
# block-ack снижают эти невидимые потери под нагрузкой.
#
# ВАЖНО по памяти (README §19): STATIC_RX_BUFFER_NUM берёт внутреннюю
# DMA-память (~1.6 КБ на буфер), а не PSRAM. 10 -> 16 = примерно +9.6 КБ
# internal RAM постоянно. DYNAMIC_RX_BUFFER_NUM ограничивает пиковое число
# динамических RX-буферов (выделяются по мере нужды). RX_BA_WIN должен
# оставаться <= DYNAMIC_RX_BUFFER_NUM и <= 2*STATIC_RX_BUFFER_NUM; 16 это
# условие выполняет. После сборки обязательно сверить linker size diff и
# runtime-лог свободной internal RAM на плате: если internal heap просел
# опасно низко — уменьшить STATIC_RX_BUFFER_NUM обратно.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=64
CONFIG_ESP_WIFI_RX_BA_WIN=16
