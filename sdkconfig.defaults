CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# PSRAM Configuration
CONFIG_ESP32S3_SPIRAM_SUPPORT=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_TRY_ALLOCATE_PSRAM_FIRST=y

# ИСПРАВЛЕНИЕ: Подними лимит для Internal Allocations (по умолчанию 4096)
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# ИСПРАВЛЕНИЕ: Увеличь резерв внутренней памяти (32КБ очень мало для Wi-Fi/FATFS/DMA)
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=65536

# Heap Configuration
CONFIG_HEAP_MEMORY_PROTECTION=y

# FreeRTOS
CONFIG_FREERTOS_THREAD_LOCAL_STORAGE_POINTER_IN_TCB=y

# Logging
CONFIG_LOG_DEFAULT_LEVEL=2

# Performance
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=10
